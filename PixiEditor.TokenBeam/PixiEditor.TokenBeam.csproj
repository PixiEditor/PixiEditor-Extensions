<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
        <OutputType>Exe</OutputType>
        <PublishTrimmed>true</PublishTrimmed>
        <WasmSingleFileBundle>true</WasmSingleFileBundle>
        <GenerateExtensionPackage>true</GenerateExtensionPackage>
        <PixiExtOutputPath>..\..\PixiEditor\src\PixiEditor.Desktop\bin\Debug\net10.0\Extensions</PixiExtOutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
        <RootNamespace>PixiEditor.TokenBeam</RootNamespace>
    </PropertyGroup>


    <ItemGroup>
        <None Remove="extension.json"/>
        <Content Include="extension.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>


    <ItemGroup>
      <PackageReference Include="PixiEditor.Extensions.Sdk" Version="0.2.1-dev" />
    </ItemGroup>

</Project>
